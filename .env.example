# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Dashboard → Project Settings → API → service_role / secret key (server only!)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Postgres connection. For hosted servers use the Session Pooler URI (IPv4-compatible).
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── AI (Anthropic) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
# Coach model (chat, plan edits). Default: claude-opus-5-5
# COACH_MODEL=claude-opus-5-5
# COACH_EFFORT=medium            # low | medium | high
# Post-workout notes (cheap, fast). Default: claude-haiku-5-5
# ANALYSIS_MODEL=claude-haiku-5-5

# ── Strava ────────────────────────────────────────────────────────────────────
# https://www.strava.com/settings/api — set Authorization Callback Domain to your APP_URL host
# (e.g. vista-api.onrender.com; "localhost" works for development). iOS returns through
# /api/strava/app-callback, which deep-links back into the app.
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
# STRAVA_WEBHOOK_VERIFY_TOKEN=any-random-string   (derived automatically if unset)

# Public URL of this server. When it's https, the server registers a Strava webhook
# on boot so new workouts import within seconds; otherwise it polls every 15 min.
APP_URL=http://localhost:3003
# Signs OAuth state. Any long random string in production.
STATE_SECRET=change-me
# Extra allowed CORS origins (comma-separated). capacitor://localhost is always allowed.
# CORS_ORIGINS=

# ── Client (exposed to the browser — public values only) ─────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# iOS release builds only: where the bundled app calls the API.
# VITE_API_URL=https://vista-api.onrender.com
